rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return isSignedIn() ? userDoc().data.role : null;
    }

    function isActive() {
      return isSignedIn() && userDoc().data.active == true;
    }

    function isAdmin() {
      return isActive() && role() == 'admin';
    }

    function isManagerUp() {
      return isActive() && (role() == 'admin' || role() == 'manager');
    }

    function isStaffUp() {
      return isActive() && (role() == 'admin' || role() == 'manager' || role() == 'staff');
    }

    // Users can read their own profile (needed at login to resolve their role).
    // Only admins can create/update/deactivate accounts.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Shop settings: any signed-in active user can read (needed for invoice printing),
    // only admins can write.
    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Customers: admin + manager can create/delete. Staff can read (to pick a customer on an
    // invoice/payment) and update — Phase 3's invoice/payment transactions write the customer's
    // running `outstanding` balance as part of the same atomic write, so staff needs update
    // access here, not just on invoices/payments.
    match /customers/{customerId} {
      allow read: if isStaffUp();
      allow create: if isManagerUp();
      allow update: if isStaffUp();
      allow delete: if isAdmin();
    }

    // Products: admin + manager manage the catalog and price lists. Staff can only read
    // (needed for the smart search / invoice line-item lookup in Phase 3).
    match /products/{productId} {
      allow read: if isStaffUp();
      allow create, update, delete: if isManagerUp();
    }

    // Price list versions + their immutable item snapshots: write on upload/commit only
    // (no update/delete — a committed version must never change, so old invoices that
    // reference a versionId always resolve to the original prices). Staff can read so a
    // future "view original invoice price" feature can look up historical items.
    match /priceListVersions/{versionId} {
      allow read: if isStaffUp();
      allow create: if isManagerUp();
      allow update, delete: if false;

      match /items/{itemId} {
        allow read: if isStaffUp();
        allow create: if isManagerUp();
        allow update, delete: if false;
      }
    }

    // Invoices: any active staff+ can create/read (needed for Staff's "Create Invoice" duty).
    // Update is also allowed for staff+ because recording a payment (Staff's "Receive Payment"
    // duty) writes amountPaid/balanceDue/status onto the linked invoice in the same transaction.
    // Cost/profit fields are enforced client-side hidden for staff; a future phase should
    // split cost data into an admin/manager-only subcollection for full server-side enforcement.
    match /invoices/{invoiceId} {
      allow read: if isStaffUp();
      allow create, update: if isStaffUp();
      allow delete: if isManagerUp();
    }

    // Payments: staff+ can create (Staff's "Receive Payment" duty) and read. Payments are a
    // financial audit trail so they are never edited or deleted, even by managers/admins.
    match /payments/{paymentId} {
      allow read: if isStaffUp();
      allow create: if isStaffUp();
      allow update, delete: if false;
    }

    // Ledger entries: auto-generated debit/credit rows behind every invoice and payment.
    // Staff+ can create them (as part of the invoice/payment transaction) and read them
    // (customer ledger view). Immutable — never updated or deleted, so the running balance
    // trail always reconciles.
    match /ledgerEntries/{entryId} {
      allow read: if isStaffUp();
      allow create: if isStaffUp();
      allow update, delete: if false;
    }

    // Sequence counters (invoice #, receipt #, customer #). Staff+ needs to increment these
    // when creating invoices/payments/customers.
    match /counters/{counterId} {
      allow read: if isStaffUp();
      allow write: if isStaffUp();
    }

    // Default deny for anything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
