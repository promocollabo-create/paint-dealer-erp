rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /shop/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
