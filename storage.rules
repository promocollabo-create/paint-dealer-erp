rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Current shop logo upload path (see src/app/(dashboard)/settings/page.tsx).
    match /shop-settings/logo/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Legacy path from before the logo upload path was changed — kept so logos uploaded
    // under the old scheme keep working (their stored logoUrl still points here).
    match /shop/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
